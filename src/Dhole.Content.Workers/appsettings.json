{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=dhole_content;Username=postgres;Password=postgres"
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=dhole_content;Username=postgres;Password=postgres",
    "CommandTimeoutSeconds": 60,
    "EnableHealthCheck": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "dhole_content_worker:",
    "DefaultExpirationMinutes": 30,
    "EnableHealthCheck": true,
    "Streams": {
      "Enabled": true,
      "DefaultStreamName": "dhole.content.events",
      "SourceService": "DholeContentService",
      "Destinations": {
        "content.created": "dhole.content.events",
        "content.updated": "dhole.content.events",
        "content.published": "dhole.content.events",
        "content.unpublished": "dhole.content.events",
        "content.scheduled": "dhole.content.events",
        "content.archived": "dhole.content.events",
        "content.deleted": "dhole.content.events",
        "audit.event.registered": "dhole.audit.events",
        "notifications.notification.requested": "dhole.notifications.events"
      },
      "Publisher": {
        "MaxLength": 10000,
        "UseApproximateMaxLength": true
      },
      "Consumer": {
        "Enabled": true,
        "StreamName": "dhole.content.events",
        "ConsumerGroup": "dhole-content",
        "ConsumerName": "dhole-content-worker",
        "BatchSize": 50,
        "PollingIntervalSeconds": 5,
        "ReadPendingMessages": true,
        "ErrorDelaySeconds": 10
      }
    }
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "dhole_content",
    "EnableHealthCheck": true
  },
  "Messaging": {
    "Outbox": {
      "BatchSize": 50,
      "MaxRetryCount": 3,
      "PollingIntervalSeconds": 10,
      "BackgroundService": {
        "Enabled": true,
        "PollingIntervalSeconds": 10,
        "BatchSize": 50,
        "RunImmediately": true,
        "ErrorDelaySeconds": 5,
        "UseDistributedLock": false,
        "LockDurationSeconds": 60
      }
    },
    "Inbox": {
      "ProcessedMessageExpirationDays": 7,
      "Cleanup": {
        "Enabled": true,
        "OlderThanDays": 7,
        "BatchSize": 100,
        "PollingIntervalSeconds": 300,
        "RunImmediately": true
      }
    }
  },
  "Workers": {
    "Enabled": true,
    "MaxRetryCount": 3,
    "RetryDelaySeconds": 5,
    "UseDistributedLock": false,
    "LockDurationSeconds": 60,
    "StopOnUnhandledException": false,
    "Schedule": {
      "IntervalSeconds": 60,
      "RunImmediately": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
